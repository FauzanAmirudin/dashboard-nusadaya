# ==============================================================================
# ENVIRONMENT CONFIGURATION — NUSADAYA DASHBOARD
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DB=nusadaya
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_database_password@127.0.0.1:5432/nusadaya

# Redis Configuration (Cache & Sessions)
REDIS_URL=redis://127.0.0.1:6379

# Port Mapping Standar
WEB_PORT=80
API_PORT=3001
POSTGRES_PORT_BIND=127.0.0.1:5432
REDIS_PORT_BIND=127.0.0.1:6379

# Application & Authentication
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters
TZ=Asia/Jakarta

# Frontend & API Connection URLs
# Untuk IP VPS: http://IP_VPS (frontend) dan http://IP_VPS:3001 (api)
# Untuk Domain: https://dashboard.domainanda.com dan https://api.domainanda.com
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# Optimization & Connection Pool Configuration
DB_POOL_MAX=20
CACHE_MAX_MEMORY_KEYS=2000
CACHE_TTL_STUDENT_LIST=60
CACHE_TTL_DASHBOARD=120
CACHE_TTL_DETAIL=180
CACHE_TTL_DEFAULT=120

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Nusadaya OneData <noreply@onedata-nusadaya.com>"

# OTP Security Configuration
OTP_HMAC_SECRET=generate_random_64_character_hex_secret_here
OTP_LOGIN_ENABLED=true

