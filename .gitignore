# ==============================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
node_modules/
**/node_modules/
.pnp/
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ==============================================================================
# BUILD OUTPUTS & CACHES
# ==============================================================================
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/
.cache/
**/.cache/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# ==============================================================================
# ENVIRONMENT VARIABLES & SECRETS (NEVER COMMIT SENSITIVE KEYS)
# ==============================================================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
**/.env
**/.env.*
**/.env.local
**/.env*.local

# Except example template files
!.env.example
!**/.env.example
!.env.template
!**/.env.template

# Security Certificates & SSH Keys
*.pem
*.key
*.cert
*.cer
*.crt
*.der
*.pfx
*.p12
*.jks
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub

# ==============================================================================
# LOGS, DEBUG & RUNTIME
# ==============================================================================
*.log
*.log.*
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.log*
*.stackdump

# ==============================================================================
# TESTING & BENCHMARKS
# ==============================================================================
coverage/
**/coverage/
.nyc_output/
test-results/
*.lcov

# ==============================================================================
# UPLOADS, USER FILES & STORAGE (PERSISTENT DATA)
